# PostgreSQL connection (Supabase → use the "Connection string" / URI, with ?pgbouncer=true for pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth — CHANGE these in production
JWT_SECRET="generate-a-long-random-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Email (optional — leave empty to log-only)
RESEND_API_KEY=""

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL="https://ctl-couriers-ltd.com"
